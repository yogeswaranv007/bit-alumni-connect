# ===================================================================
# BIT Connect - Backend Configuration Template
# Copy this file as a reference for production / deployment environments.
# ===================================================================

# Server Port
PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/bit_connect
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# JWT Secret (Must be a 256-bit / 32-byte hex-encoded key for production)
JWT_SECRET=your_production_256_bit_secure_hex_encoded_secret_key_here
JWT_EXPIRATION_MS=86400000

# Allowed CORS Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://bitconnect.bitsathy.ac.in
